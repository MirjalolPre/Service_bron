# Copy this file to .env and fill in the values. Never commit .env.
# Comments must be on their own lines (.env is read as a .properties file).

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Bot username without @ (optional: it is read from Telegram when empty)
TELEGRAM_BOT_USERNAME=

# Telegram user ids of super admins, comma separated (get yours from @userinfobot)
SUPER_ADMIN_IDS=123456789,987654321

APP_DEFAULT_TIMEZONE=Asia/Tashkent

# Fake shops, barbers, prices, blocked periods and bookings for testing (dev only).
# DEMO_DATA=true creates them once at startup; DEMO_DATA_RESET=true deletes and recreates them.
# The first super admin becomes owner and barber of the demo shop "Barber House"
# (set DEMO_STAFF_TELEGRAM_ID to another Telegram id, or to "none" to turn this off).
DEMO_DATA=false
DEMO_DATA_RESET=false
DEMO_STAFF_TELEGRAM_ID=

# Production only (in dev, Docker Compose support configures the DB):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/navbat
# SPRING_DATASOURCE_USERNAME=navbat
# SPRING_DATASOURCE_PASSWORD=navbat
