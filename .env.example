# Copy this file to .env and fill in the values. Never commit .env.
# Comments must be on their own lines (.env is read as a .properties file).

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Bot username without @ (optional: it is read from Telegram when empty)
TELEGRAM_BOT_USERNAME=

# Telegram user ids of super admins, comma separated (get yours from @userinfobot)
SUPER_ADMIN_IDS=123456789,987654321

APP_DEFAULT_TIMEZONE=Asia/Tashkent

# Production only (in dev, Docker Compose support configures the DB):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/navbat
# SPRING_DATASOURCE_USERNAME=navbat
# SPRING_DATASOURCE_PASSWORD=navbat
